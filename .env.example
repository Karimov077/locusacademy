# Lokus Academy — Environment Variables
# Bu fayl faqat o'zgaruvchi nomlarini ko'rsatadi.
# Haqiqiy qiymatlarni HECH QACHON bu faylga yozma!
# .env.local faylini yaratib, qiymatlrni u yerga yoz.

# Telegram Bot Token (BotFather'dan olinadi: https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (arizalar yuborilishi kerak bo'lgan guruh/kanal ID)
# Guruh ID olish: guruhga @userinfobot qo'shing va /start deb yozing
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
